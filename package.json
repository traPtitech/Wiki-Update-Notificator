{
  "name": "wiki-update-notificator",
  "version": "1.0.6",
  "description": "Sends webhook to traQ when wiki page is updated.",
  "main": "src/index.ts",
  "scripts": {
    "lint": "eslint \"**/*.{ts,js,json}\"",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc && cp src/appsscript.json dist/appsscript.json"
  },
  "author": "traP",
  "license": "MIT",
  "dependencies": {
    "@types/google-apps-script": "1.0.65"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@typescript-eslint/eslint-plugin": "6.1.0",
    "@typescript-eslint/parser": "6.1.0",
    "eslint": "8.45.0",
    "eslint-config-prettier": "8.8.0",
    "prettier": "3.0.0",
    "typescript": "4.9.5"
  },
  "private": true
}
